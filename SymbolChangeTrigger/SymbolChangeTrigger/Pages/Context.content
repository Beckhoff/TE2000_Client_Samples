  "bottomRight": 14,
  "bottomRightUnit": "px"
}
</script>
<div id="ContextBadgeText" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-width="120" data-tchmi-height="28" data-tchmi-text="Recommended" data-tchmi-text-font-weight="Bold">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-centered"
]
</script>
