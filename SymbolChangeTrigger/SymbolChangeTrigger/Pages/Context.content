</div>
<div id="ContextDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="104" data-tchmi-right="168">
<p style="margin: 0; font-size: 16px; line-height: 24px;">The condition uses <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">%ctx%args[0]%/ctx%</code>, the value that was delivered with the event. It is resolved in the client, so no additional request is sent, the actions run immediately and always see the value that raised the event.</p>
</div>
<div id="ContextCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="148" data-tchmi-height="312" data-tchmi-width="460">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">"event": "%s%MachineRunning%/s%",
"actions": [{
  "objectType": "Condition",
  "parts": [{
    "if": [{
      "compare1": {
        "objectType": "Symbol",
        <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"symbolExpression": "%ctx%args[0]%/ctx%"</span>
      },
      "compareOperator": "==",
      "compare2": { "value": true }
    }],
    "then": [ owner::FillColor = green ]
  },
  { "else": [ owner::FillColor = red ] }]
}]</pre>
</div>
<div id="ContextLamp" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiEllipse" data-tchmi-left="548" data-tchmi-top="234" data-tchmi-width="140" data-tchmi-height="140" data-tchmi-stroke-thickness="6" data-tchmi-stroke-thickness-unit="px">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%MachineRunning%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "symbolExpression": "%ctx%args[0]%/ctx%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/Boolean",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::FillColor%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "color": "rgba(46, 160, 67, 1)"
                  }
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::FillColor%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "color": "rgba(215, 58, 73, 1)"
                  }
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ],
    "displayName": "Context: ContextLamp is green while MachineRunning is true, otherwise red"
  }
]
</script>
<script data-tchmi-target-attribute="data-tchmi-fill-color" type="application/json">
{
  "color": "rgba(206, 212, 218, 1)"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-stroke-color" type="application/json">
{
  "color": "rgba(255, 255, 255, 1)"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
{
  "topLeft": 50,
  "topLeftUnit": "%",
  "topRight": 50,
  "topRightUnit": "%",
  "bottomLeft": 50,
  "bottomLeftUnit": "%",
  "bottomRight": 50,
  "bottomRightUnit": "%"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-box-shadow" type="application/json">
[
  {
    "color": {
      "color": "rgba(0, 0, 0, 0.25)"
    },
    "offsetX": 0,
    "offsetY": 2,
    "blur": 8,
    "spread": 0,
    "inset": false,
    "offsetXUnit": "px",
    "offsetYUnit": "px",
    "blurUnit": "px",
    "spreadUnit": "px"
  }
]
</script>
</div>
</div>
</div>
