<div id="ModuleImportsContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="16" data-tchmi-top="64" data-tchmi-right="16" data-tchmi-min-width="884" data-tchmi-height="1241">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "background-container"
]
</script>
<div id="ModuleImportsDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="120" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ModuleImports</code> and <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ModuleImportsJs</code> are the same control, written in TypeScript and in JavaScript. They show the different ways to import values, modules and the framework API.</p>
</div>
<div id="ModuleImportsModuleText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="160" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">1. Load the control as ES module</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">Description.json</code> lists only the main file, with the type <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">EsModule</code>.</p>
</div>
<div id="ModuleImportsModuleCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="216" data-tchmi-height="143" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">"dependencyFiles": [
    {
        "name": "ModuleImports.js",
        <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"type": "EsModule"</span>,
        "description": "Imports are not listed here!"
    }
]</pre>
</div>
<div id="ModuleImportsRelativeText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="383" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Import with a relative path</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">Named, renamed and default imports of <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">someNumbers.js</code>.</p>
</div>
<div id="ModuleImportsRelativeCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="439" data-tchmi-height="75" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">import { randomNumber, badNamedNumber as betterName }
    from <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"./someNumbers.js"</span>;
import defaultNumber from <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"./someNumbers.js"</span>;</pre>
</div>
<div id="ModuleImportsBareText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="538" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">3. Import with a bare module name</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">esmoduleImports</code> in <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">Manifest.json</code> maps the name for the browser.</p>
</div>
<div id="ModuleImportsBareCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="594" data-tchmi-height="194" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">import { TcHmiShortName } from <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"textmodule"</span>;

// Manifest.json
"esmoduleImports": [
    {
        "imports": {
            <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"textmodule": "ModuleImports/someText.js"</span>
        }
    }
]</pre>
</div>
<div id="ModuleImportsFrameworkText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="812" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">4. Import the framework API</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">TypeScript only, plain JavaScript keeps the global TcHmi API.</p>
</div>
<div id="ModuleImportsFrameworkCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="868" data-tchmi-height="160" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">import { TcHmiControl, Controls }
    from <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"Beckhoff.TwinCAT.HMI.Framework/index.esm.js"</span>;

export class ModuleImports extends TcHmiControl.Control {
    // ...
}
Controls.registerEx('ModuleImports',
    'TcHmi.Controls.ExampleControls', ModuleImports);</pre>
</div>
<div id="ModuleImportsPackageText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="1052" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">5. Import from a package in the HMI project</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">usesPackageImport.ts</code> imports with the package name of the module.</p>
</div>
<div id="ModuleImportsPackageCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="1108" data-tchmi-height="109" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">import { randomNumber }
    from
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"ExampleControls/ModuleImports/someNumbers.js"</span>;

TcHmi.Log.infoEx('imported number: %o', randomNumber);</pre>
</div>
