<div id="ClassicContent" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-min-width="816" data-tchmi-height="1404">
<div id="ClassicHeadline" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="32" data-tchmi-top="16" data-tchmi-height="32" data-tchmi-right="16" data-tchmi-text="Classic" data-tchmi-word-wrap="True">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "headline-2"
]
</script>
</div>
<div id="ClassicContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="16" data-tchmi-top="64" data-tchmi-right="16" data-tchmi-min-width="784" data-tchmi-height="1324">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "background-container"
]
</script>
<div id="ClassicDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="120" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ColorChangeClassic</code> is <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ColorChange</code> written the classic way: a TypeScript namespace with the global <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">TcHmi</code> API, loaded as classic script. Existing controls of this kind keep working, new controls should be ES modules like <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ColorChange</code>. The switch at the bottom changes its value as well.</p>
</div>
<div id="ClassicNamespaceText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="160" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">1. Namespace instead of module</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">The classic control lives in a namespace of the global <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">TcHmi</code> object.</p>
</div>
<div id="ClassicNamespaceCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="216" data-tchmi-height="262" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">// ColorChangeClassic.ts
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">namespace TcHmi.Controls.ExampleControls</span> {
    export class ColorChangeClassic
        extends <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmi.Controls.System.TcHmiControl</span> {
        // ...
    }
}

// ColorChange.ts
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">import</span> { Controls, EventProvider, TcHmiControl, ValueConverter }
    from 'Beckhoff.TwinCAT.HMI.Framework/index.esm.js';
export class ColorChange extends <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmiControl.Control</span> {
    // ...
}</pre>
</div>
<div id="ClassicApiText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="502" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Global API instead of imported API</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">The code is the same, only the access to the API differs.</p>
</div>
<div id="ClassicApiCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="558" data-tchmi-height="211" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">// ColorChangeClassic
const convertedValue =
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmi.ValueConverter</span>.toBoolean(valueNew, false);
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmi.EventProvider</span>.raise(this.__id + '.onPropertyChanged',
    { propertyName: 'Value' });

// ColorChange
const convertedValue =
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">ValueConverter</span>.toBoolean(valueNew, false);
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">EventProvider</span>.raise(this.__id + '.onPropertyChanged',
    { propertyName: 'Value' });</pre>
</div>
<div id="ClassicRegisterText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="793" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">3. Registration</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">The classic control registers the class of the namespace.</p>
</div>
<div id="ClassicRegisterCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="849" data-tchmi-height="160" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">// ColorChangeClassic
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmi.Controls.registerEx</span>('ColorChangeClassic',
    'TcHmi.Controls.ExampleControls',
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">TcHmi.Controls.ExampleControls.ColorChangeClassic</span>);

// ColorChange
<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">Controls.registerEx</span>('ColorChange',
    'TcHmi.Controls.ExampleControls', <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">ColorChange</span>);</pre>
</div>
<div id="ClassicLoadingText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="1033" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">4. Compile and load</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">An own <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">tsconfig.json</code> compiles the classic control without modules.</p>
</div>
<div id="ClassicLoadingCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="1089" data-tchmi-height="211" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">// ColorChangeClassic/tsconfig.json
"module": <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"none"</span>

// ColorChangeClassic/Description.json
{ "name": "ColorChangeClassic.js", "type": <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"JavaScript"</span> }

// tsconfig.json of the package
"module": <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"es2022"</span>

// ColorChange/Description.json
{ "name": "ColorChange.js", "type": <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">"EsModule"</span> }</pre>
</div>
