  "text-size-default"
]
</script>
</div>
<div id="RecipeSelect" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiCombobox" data-tchmi-left="32" data-tchmi-top="40" data-tchmi-height="36" data-tchmi-width="240" data-tchmi-combobox-text="Select recipe" data-tchmi-src-data="%f%TcHmi.Functions.RecipeManagementSample.ListRecipesAsReferenceArray(%s%TcHmiRecipeManagement.Config::recipeList%/s%)%/f%"></div>
