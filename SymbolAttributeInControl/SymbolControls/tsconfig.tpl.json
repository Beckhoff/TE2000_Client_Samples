{
  "$schema": "http://json.schemastore.org/tsconfig",
  "compileOnSave": true,
  "compilerOptions": {
    "module": "es2022",
    "target": "ES2022",
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "paths": {
      "Beckhoff.TwinCAT.HMI.Framework/*": [
        "./$(Beckhoff.TwinCAT.HMI.Framework).InstallPath/*"
      ],
      "Beckhoff.TwinCAT.HMI.Framework": [
        "./$(Beckhoff.TwinCAT.HMI.Framework).InstallPath/index.esm.d.ts"
      ]
    },
    "types": [],
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "alwaysStrict": true
  },
  "include": [],
  "files": [
    "ClassicControl/ClassicControl.ts",
    "HybridControl/HybridControl.ts",
    "ObjectResolverControl/ObjectResolverControl.ts"
  ]
}