<div id="PumpRunningSwitch" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiToggleSwitch" data-tchmi-left="216" data-tchmi-top="42" data-tchmi-width="60" data-tchmi-height="26" data-tchmi-text="" data-tchmi-state-symbol="%s%PumpRunning%/s%"></div>
<div id="FanRunningLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="336" data-tchmi-top="12" data-tchmi-height="24" data-tchmi-width="108" data-tchmi-text="FanRunning" data-tchmi-word-wrap="False">
