<div id="LightOnLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="456" data-tchmi-top="12" data-tchmi-height="24" data-tchmi-width="108" data-tchmi-text="LightOn" data-tchmi-word-wrap="False">
