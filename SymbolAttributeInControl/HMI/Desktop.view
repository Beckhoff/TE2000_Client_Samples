<div id="LightOnSwitch" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiToggleSwitch" data-tchmi-left="456" data-tchmi-top="42" data-tchmi-width="60" data-tchmi-height="26" data-tchmi-text="" data-tchmi-state-symbol="%s%LightOn%/s%"></div>
<div id="FooterDivider" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="588" data-tchmi-top="20" data-tchmi-width="1" data-tchmi-height="56">
<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "#a3b0bb"
}
</script>
</div>
<div id="FooterHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="612" data-tchmi-top="18" data-tchmi-height="60" data-tchmi-right="32" data-tchmi-text="The switches write the server symbols like a PLC would. The controls on the pages show every change, and a click in a control changes the switch." data-tchmi-word-wrap="True" data-tchmi-text-font-size="14" data-tchmi-text-font-size-unit="px" data-tchmi-text-vertical-alignment="Center">
</div>
</div>
<div id="Region_Center" data-tchmi-type="TcHmi.Controls.System.TcHmiRegion" data-tchmi-left="0" data-tchmi-top="%ctrl%Header_Top::Height%/ctrl%" data-tchmi-scrolling="Yes" data-tchmi-bottom="%ctrl%Container_Bottom::Height%/ctrl%" data-tchmi-right="%ctrl%Accordion_Navigation_Right::Width%/ctrl%" data-tchmi-target-content="Pages/Classic.content"></div>
</div>
