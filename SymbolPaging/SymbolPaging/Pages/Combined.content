<div id="CombinedLifecycleText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="419" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Subscribe only while the table is shown</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">The subscription is removed when the page and its table are detached.</p>
</div>
<div id="CombinedLifecycleCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="475" data-tchmi-height="211" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">EventProvider.register(<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">'CombinedGrid.onAttached'</span>, () =&gt; {
    // ... create the command
    subscriptionId = Server.subscribe(...);
});

EventProvider.register(<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">'CombinedGrid.onDetached'</span>, () =&gt; {
    if (subscriptionId !== null) {
        <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">Server.unsubscribe</span>(subscriptionId);
        subscriptionId = null;
    }
});</pre>
</div>
</div>
</div>
