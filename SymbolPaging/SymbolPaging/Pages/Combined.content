<div id="CombinedContent" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-min-width="932" data-tchmi-height="790">
<div id="CombinedHeadline" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="32" data-tchmi-top="16" data-tchmi-height="32" data-tchmi-right="16" data-tchmi-text="Filtering, sorting and paging combined" data-tchmi-word-wrap="True">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "headline-2"
]
</script>
</div>
<div id="CombinedContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="16" data-tchmi-top="64" data-tchmi-right="16" data-tchmi-min-width="900" data-tchmi-height="710">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "background-container"
]
</script>
<div id="CombinedDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="72" data-tchmi-right="24">
<p style="margin: 0; font-size: 16px; line-height: 24px;">One command can contain <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">filter</code>, <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">orderBy</code>, <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">offset</code> and <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">limit</code>. The server filters the array first, then sorts the matching items and returns the requested part of them. <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">maxEntries</code> contains the number of matching items, not the length of the array.</p>
</div>
<div id="CombinedCommandText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="120" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">1. Filter, sort and page</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">The items 10 to 29 of all lowercase items, longest strings first.</p>
</div>
<div id="CombinedCommandCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="176" data-tchmi-height="211" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, LoremIpsumItem[]&gt; = {
    symbol: 'LoremIpsumItems',
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">filter: 'properties::hasUppercase == false'</span>,
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">orderBy: 'properties::length DESC, text ASC'</span>,
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">offset: 10</span>,
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">limit: 20</span>,
    filterMap: [],
};

subscriptionId = Server.subscribe&lt;LoremIpsumItem[]&gt;(
    [command], 500, (data) =&gt; { /* showResult(...) */ });</pre>
</div>
