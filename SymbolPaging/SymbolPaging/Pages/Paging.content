<div id="PagingResultText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="752" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">3. Show the result</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">showResult</code> fills a table with the items and their original index.</p>
</div>
<div id="PagingResultCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="808" data-tchmi-height="160" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command = data.response?.commands?.[0];
// ...
grid?.setSrcData(<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">command.readValue</span>.map((item, i) =&gt; ({
    index: <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">command.filterMap</span>?.[i],
    ...toRow(item),
})));
label?.setText(`Result: ${command.readValue.length} of ` +
    `${<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">command.maxEntries</span>} items`);</pre>
</div>
</div>
</div>
