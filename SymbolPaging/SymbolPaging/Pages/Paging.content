<div id="PagingRequestText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="436" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Read a page once</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">A <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ReadWrite</code> request reads the items 30 to 39 a single time.</p>
</div>
<div id="PagingRequestCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="492" data-tchmi-height="228" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, string[]&gt; = {
    symbol: 'LoremIpsum',
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">offset: 30</span>,
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">limit: 10</span>,
    filterMap: [],
};

<span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">Server.request</span>&lt;unknown, string[]&gt;(
    { <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">requestType: 'ReadWrite'</span>, commands: [command] },
    (data) =&gt; {
        showResult('PagingRequest', data, (value) =&gt; ({ value }));
    });</pre>
</div>
<div id="PagingRequestLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="576" data-tchmi-top="436" data-tchmi-height="24" data-tchmi-width="300" data-tchmi-text="Result" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
