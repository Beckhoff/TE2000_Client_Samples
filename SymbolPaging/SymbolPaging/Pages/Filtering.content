[
  "background-container"
]
</script>
<div id="FilteringDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="72" data-tchmi-right="24">
<p style="margin: 0; font-size: 16px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">filter</code> only returns the items which match. A comparison has a <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">path</code>, a <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">comparator</code> and a <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">value</code>. Comparisons are combined with <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">AND</code> or <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">OR</code> and nested for precedence. A filter is written as JSON objects or as a string. <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">maxEntries</code> contains the number of matching items.</p>
</div>
<div id="FilteringValueText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="120" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">1. Filter by value</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">JSON object syntax: all strings of <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">LoremIpsum</code> which contain <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">em</code>.</p>
</div>
<div id="FilteringValueCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="176" data-tchmi-height="262" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, string[]&gt; = {
    symbol: 'LoremIpsum',
    filter: [
        {
            <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">path: '{value}'</span>,
            <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">comparator: 'contains'</span>,
            <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">value: 'em'</span>,
        },
    ],
    filterMap: [],
};

valueFilterSubscriptionId = Server.subscribe&lt;string[]&gt;(
    [command], 500, (data) =&gt; { /* showResult(...) */ });</pre>
</div>
<div id="FilteringValueLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="576" data-tchmi-top="120" data-tchmi-height="24" data-tchmi-width="300" data-tchmi-text="Result" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-size-default"
]
</script>
</div>
