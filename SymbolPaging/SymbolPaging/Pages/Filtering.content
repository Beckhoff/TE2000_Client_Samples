<div id="FilteringPropertyText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="470" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Filter by a property</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">String syntax: all items whose <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">hasUppercase</code> is true.</p>
</div>
<div id="FilteringPropertyCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="526" data-tchmi-height="177" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, LoremIpsumItem[]&gt; = {
    symbol: 'LoremIpsumItems',
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">filter: 'properties::hasUppercase == true'</span>,
    filterMap: [],
};

Server.request&lt;unknown, LoremIpsumItem[]&gt;(
    { requestType: 'ReadWrite', commands: [command] },
    (data) =&gt; { /* showResult(...) */ });</pre>
</div>
