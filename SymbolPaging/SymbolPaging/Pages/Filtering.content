<div id="FilteringCombinedText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="766" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">3. Combine and nest comparisons</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">Uppercase items, or items with <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">o</code> as second char and 6 or more chars.</p>
</div>
<div id="FilteringCombinedCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="822" data-tchmi-height="381" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">filter: [
    {
        path: 'properties::hasUppercase',
        comparator: '==',
        value: true,
    },
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">{ logic: 'OR' }</span>,
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">[</span> // Nested filters are evaluated first
        {
            path: 'properties::chars[1]',
            comparator: '==',
            value: 'o',
        },
        <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">{ logic: 'AND' }</span>,
        {
            path: 'properties::length',
            comparator: '&gt;=',
            value: 6,
        },
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;"></span>],
],</pre>
</div>
