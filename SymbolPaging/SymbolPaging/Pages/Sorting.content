<div id="SortingContent" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-min-width="932" data-tchmi-height="872">
<div id="SortingHeadline" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="32" data-tchmi-top="16" data-tchmi-height="32" data-tchmi-right="16" data-tchmi-text="Sorting" data-tchmi-word-wrap="True">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "headline-2"
]
</script>
</div>
<div id="SortingContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="16" data-tchmi-top="64" data-tchmi-right="16" data-tchmi-min-width="900" data-tchmi-height="792">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "background-container"
]
</script>
<div id="SortingDescription" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="24" data-tchmi-height="72" data-tchmi-right="24">
<p style="margin: 0; font-size: 16px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">orderBy</code> sorts an array on the server. It contains the path to a property, or <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">{value}</code> for an array of strings, numbers or booleans, followed by <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">ASC</code> or <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">DESC</code>. The server sorts before it applies <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">offset</code> and <code style="font-family: Consolas, 'Courier New', monospace; font-size: 14px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">limit</code>, so a page always contains the right part of the sorted array.</p>
</div>
<div id="SortingValueText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="120" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">1. Sort by value</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;"><code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">{value}</code> sorts the strings of <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">JumbledAlphabet</code> alphabetically.</p>
</div>
<div id="SortingValueCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="176" data-tchmi-height="194" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, string[]&gt; = {
    symbol: 'JumbledAlphabet',
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">orderBy: '{value} ASC'</span>,
    filterMap: [],
};

subscriptionId = Server.subscribe&lt;string[]&gt;([command], 500,
    (data) =&gt; {
        showResult('SortingValue', data, (value) =&gt; ({ value }));
    });</pre>
</div>
<div id="SortingValueLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="576" data-tchmi-top="120" data-tchmi-height="24" data-tchmi-width="300" data-tchmi-text="Result" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-size-default"
]
</script>
</div>
