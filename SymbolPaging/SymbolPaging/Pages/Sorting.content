<div id="SortingPropertyText" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="416" data-tchmi-height="48" data-tchmi-width="528">
<p style="margin: 0; font-size: 16px; line-height: 24px; font-weight: bold;">2. Sort by properties</p>
<p style="margin: 0; font-size: 14px; line-height: 24px;">Criteria are separated by commas, nested properties by <code style="font-family: Consolas, 'Courier New', monospace; font-size: 13px; background: rgba(0, 0, 0, 0.07); padding: 1px 4px; border-radius: 3px;">::</code>.</p>
</div>
<div id="SortingPropertyCode" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="24" data-tchmi-top="472" data-tchmi-height="296" data-tchmi-width="528">
<pre style="margin: 0; height: 100%; box-sizing: border-box; padding: 12px 16px; overflow: hidden; background: rgba(30, 36, 48, 1); color: rgba(214, 222, 235, 1); border-radius: 4px; font-family: Consolas, 'Courier New', monospace; font-size: 13px; line-height: 17px;">const command: Server.ICommand&lt;unknown, LoremIpsumItem[]&gt; = {
    symbol: 'LoremIpsumItems',
    // Longest strings first, then alphabetically
    <span style="background: rgba(46, 160, 67, 0.45); border-radius: 3px;">orderBy: 'properties::length DESC, text ASC'</span>,
    filterMap: [],
};

Server.request&lt;unknown, LoremIpsumItem[]&gt;(
    { requestType: 'ReadWrite', commands: [command] },
    (data) =&gt; {
        showResult('SortingProperty', data, (item) =&gt; ({
            text: item.text,
            length: item.properties.length,
            hasUppercase: item.properties.hasUppercase,
        }));
    });</pre>
</div>
