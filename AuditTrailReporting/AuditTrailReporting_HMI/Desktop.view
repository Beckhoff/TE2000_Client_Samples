<div id="Desktop" data-tchmi-type="TcHmi.Controls.System.TcHmiView" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width-unit="%" data-tchmi-width="100" data-tchmi-height-unit="%" data-tchmi-height="100">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::RenderedWidth%/ctx%",
    "actions": [
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmiResponsiveBehaviour",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%i%MediaQueryList%/i%"
          },
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%i%AffectedControls%/i%"
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
<div id="Header_Top" data-tchmi-type="TcHmi.Controls.BaseTemplate.TcHmiHeader" data-tchmi-height="80" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="0">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "divider",
  "divider-top"
]
</script>
<script data-tchmi-target-attribute="data-tchmi-header-items" type="application/json">
[
  {
    "itemType": "Image",
    "priority": "2",
    "itemAlign": "Left",
    "prefWidth": 288.0,
    "prefWidthUnit": "px",
    "prefHeight": 95.0,
    "prefHeightUnit": "px",
    "minWidth": 128.0,
    "minWidthUnit": "px",
    "classList": [],
    "accessRights": [],
    "image": "Images/Beckhoff_Logo.svg",
    "altText": "Beckhoff",
    "targetRegion": "%ctrl%Region_Center%/ctrl%",
    "targetContent": "Pages/AuditTrail.content"
  },
  {
    "itemType": "Text",
    "priority": "1",
    "itemAlign": "Left",
    "prefWidth": 288.0,
    "prefWidthUnit": "px",
    "prefHeight": 95.0,
    "prefHeightUnit": "px",
    "minWidth": 128.0,
    "minWidthUnit": "px",
    "classList": [],
    "accessRights": [],
    "text": "AuditTrailReporting"
  },
  {
    "itemType": "UserManagement",
    "priority": "3",
    "itemAlign": "Right",
    "prefWidth": 288.0,
    "prefWidthUnit": "px",
    "prefHeight": 48.0,
    "prefHeightUnit": "px",
    "minWidth": 160.0,
    "minWidthUnit": "px",
    "classList": [],
    "accessRights": [],
    "allowLogout": true,
    "allowSwitchUser": true
  },
  {
    "itemType": "Time",
    "priority": "4",
    "itemAlign": "Right",
    "prefWidth": 128.0,
    "prefWidthUnit": "px",
    "prefHeight": 48.0,
    "prefHeightUnit": "px",
    "minWidth": 96.0,
    "minWidthUnit": "px",
    "classList": [],
    "accessRights": [],
    "timeDisplayLayout": "TimeDateMultiLine"
  }
]
</script>
</div>
<div id="Accordion_Navigation_Right" data-tchmi-type="TcHmi.Controls.BaseTemplate.TcHmiAccordionNavigation" data-tchmi-width="320" data-tchmi-top="%ctrl%Header_Top::Height%/ctrl%" data-tchmi-bottom="0" data-tchmi-right="0" data-tchmi-target-region="%ctrl%Region_Center%/ctrl%" data-tchmi-show-back-button="false">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "divider",
  "divider-right"
]
</script>
<script data-tchmi-target-attribute="data-tchmi-navigation-items" type="application/json">
[
  {
    "id": "AuditTrail",
    "name": "Audit trail",
    "content": "Pages/AuditTrail.content",
    "icon": "%tr%TR_Icon_AuditTrail_normal%/tr%",
    "iconActive": "%tr%TR_Icon_AuditTrail_active%/tr%",
    "iconPressed": "%tr%TR_Icon_AuditTrail_pressed%/tr%"
  },
  {
    "id": "Reporting",
    "name": "Reporting",
    "content": "Pages/Reporting.content",
    "icon": "%tr%TR_Icon_Reporting_normal%/tr%",
    "iconActive": "%tr%TR_Icon_Reporting_active%/tr%",
    "iconPressed": "%tr%TR_Icon_Reporting_pressed%/tr%"
  }
]
</script>
</div>
<div id="Container_Bottom" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="0" data-tchmi-bottom="0" data-tchmi-right="%ctrl%Accordion_Navigation_Right::Width%/ctrl%" data-tchmi-height="96">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "divider",
  "divider-bottom"
]
</script>
<div id="STestLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="32" data-tchmi-top="12" data-tchmi-height="24" data-tchmi-width="160" data-tchmi-text="MAIN.sTest" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-size-default"
]
</script>
</div>
<div id="STestInput" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiInput" data-tchmi-left="32" data-tchmi-top="40" data-tchmi-height="36" data-tchmi-width="160" data-tchmi-auto-focus-out="True" data-tchmi-text="%s%ADS.PLC1.MAIN.sTest|BindingMode=TwoWay|BindingEvent=onUserInteractionFinished%/s%"></div>
<div id="NTestLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="208" data-tchmi-top="12" data-tchmi-height="24" data-tchmi-width="120" data-tchmi-text="MAIN.nTest" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-size-default"
]
</script>
</div>
<div id="NTestInput" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiSpinboxInput" data-tchmi-left="208" data-tchmi-top="40" data-tchmi-height="36" data-tchmi-width="120" data-tchmi-auto-focus-out="True" data-tchmi-decimal-digits="0" data-tchmi-min-value="0" data-tchmi-max-value="100" data-tchmi-reset-to-last-valid-value="True" data-tchmi-value="%s%ADS.PLC1.MAIN.nTest|BindingMode=TwoWay%/s%"></div>
<div id="BTestLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="344" data-tchmi-top="12" data-tchmi-height="24" data-tchmi-width="100" data-tchmi-text="MAIN.bTest" data-tchmi-word-wrap="False">
<script data-tchmi-target-attribute="data-tchmi-class-names" type="application/json">
[
  "text-size-default"
]
</script>
</div>
<div id="BTestSwitch" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiToggleSwitch" data-tchmi-left="344" data-tchmi-top="45" data-tchmi-width="60" data-tchmi-height="26" data-tchmi-text="" data-tchmi-state-symbol="%s%ADS.PLC1.MAIN.bTest%/s%"></div>
<div id="FooterDivider" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-left="460" data-tchmi-top="20" data-tchmi-width="1" data-tchmi-height="56">
<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "#a3b0bb"
}
</script>
</div>
<div id="FooterHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="484" data-tchmi-top="18" data-tchmi-height="60" data-tchmi-right="32" data-tchmi-text="Change the PLC values to create audit trail entries. Each change is recorded with the user who is logged in." data-tchmi-word-wrap="True" data-tchmi-text-font-size="14" data-tchmi-text-font-size-unit="px" data-tchmi-text-vertical-alignment="Center">
</div>
</div>
<div id="Region_Center" data-tchmi-type="TcHmi.Controls.System.TcHmiRegion" data-tchmi-left="0" data-tchmi-top="%ctrl%Header_Top::Height%/ctrl%" data-tchmi-scrolling="Yes" data-tchmi-bottom="%ctrl%Container_Bottom::Height%/ctrl%" data-tchmi-right="%ctrl%Accordion_Navigation_Right::Width%/ctrl%" data-tchmi-target-content="Pages/AuditTrail.content"></div>
</div>
