<p style="margin: 0; display: flex; align-items: center; height: 100%; font-size: 14px; line-height: 20px;"><span>The datagrid shows the members of the selected recipe and their saved values. The column New value takes new values or the current values of the symbols.</span></p>
</div>
<div id="RecipeDatagrid" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiDatagrid" data-tchmi-left="24" data-tchmi-top="104" data-tchmi-height="140" data-tchmi-width="544" data-tchmi-header-height="32" data-tchmi-row-height="36" data-tchmi-show-row-numbers="False">
<script data-tchmi-target-attribute="data-tchmi-src-column" type="application/json">
[
  {
    "name": "memberName",
    "label": "Member",
    "width": 240,
    "editable": false,
    "control": "TextBlock",
    "widthUnit": "px",
    "resize": false,
    "minWidth": 70,
    "minWidthUnit": "px",
    "cellBackground": null,
    "textColor": null,
    "horizontalAlignment": "Center",
    "verticalAlignment": "Center",
    "format": null
  },
  {
    "name": "value",
    "label": "Saved value",
    "width": 140,
    "editable": false,
    "control": "TextBlock",
    "widthUnit": "px",
    "resize": false,
    "minWidth": 70,
    "minWidthUnit": "px",
    "cellBackground": null,
    "textColor": null,
    "horizontalAlignment": "Center",
    "verticalAlignment": "Center",
    "format": null
  },
  {
    "name": "newValue",
    "label": "New value",
    "width": 140,
    "editable": true,
    "control": "TextBox",
    "widthUnit": "px",
    "resize": false,
    "minWidth": 70,
    "minWidthUnit": "px",
    "cellBackground": null,
    "textColor": null,
    "horizontalAlignment": "Center",
    "verticalAlignment": "Center",
    "format": null
  }
]
</script>
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%TcHmiRecipeManagement.Config::recipeList%/s%",
    "actions": [
      {
        "objectType": "Comment",
        "comment": "Binds SrcData again whenever the recipe list changes, so the datagrid also shows taught and updated values."
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.Beckhoff.CreateBinding",
        "fnParams": [
          {
            "objectType": "Symbol",
            "symbolExpression": "%ctrl%RecipeDatagrid%/ctrl%",
            "valueType": "tchmi:framework#/definitions/Control"
          },
          {
            "objectType": "StaticValue",
            "valueType": "tchmi:framework#/definitions/ControlPropertyName",
            "value": "SrcData"
          },
          {
            "objectType": "Symbol",
            "symbolExpression": "%f%TcHmi.Functions.RecipeManagementFilterSample.ConvertRecipeToDatagrid(%ctrl%RecipeSelect::SelectedValue%/ctrl%)%/f%"
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
