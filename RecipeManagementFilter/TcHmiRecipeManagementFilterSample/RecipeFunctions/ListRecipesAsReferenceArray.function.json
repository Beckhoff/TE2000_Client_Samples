{
  "function": {
    "name": "ListRecipesAsReferenceArray",
    "namespace": "TcHmi.Functions.RecipeManagementFilterSample",
    "displayName": "ListRecipesAsReferenceArray",
    "visible": true,
    "category": "Recipe",
    "waitMode": "Synchronous",
    "injectContextObject": false,
    "description": "Converts the recipe list to an array of recipe references (path + '::' + name) which contain the filter text.",
    "returnValue": {
      "type": "tchmi:general#/definitions/Array",
      "description": "Recipe references"
    },
    "arguments": [
      {
        "name": "recipeList",
        "displayName": "recipeList",
        "type": "tchmi:server#/definitions/TcHmiRecipeManagement-folderRecipe",
        "description": "Recipe symbol so the function is updated again when recipe list is changed",
        "defaultValue": "%s%TcHmiRecipeManagement.Config::recipeList%/s%",
        "required": true,
        "bindable": true,
        "restParameter": false,
        "asReference": false
      },
      {
        "name": "filterText",
        "displayName": "filterText",
        "type": "tchmi:general#/definitions/String",
        "description": "Text which the recipe references have to contain, regardless of upper and lower case. An empty text returns all recipes.",
        "defaultValue": "''",
        "required": true,
        "bindable": true,
        "restParameter": false,
        "asReference": false
      }
    ]
  },
  "$schema": "../../Packages/Beckhoff.TwinCAT.HMI.Framework.14.7.23/runtimes/native1.12-tchmi/Schema/FunctionDescription.Schema.json"
}