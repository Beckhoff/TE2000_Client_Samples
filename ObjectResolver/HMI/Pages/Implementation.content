]
</script>
</div>
<div id="ImplementationMyControl" data-tchmi-type="TcHmi.Controls.MyPackage.MyControl" data-tchmi-left="600" data-tchmi-top="192" data-tchmi-width="260" data-tchmi-height="168">
<script data-tchmi-target-attribute="data-tchmi-my-attribute" type="application/json">
{
  "number1": "%i%Number1|BindingMode=TwoWay%/i%",
  "number2": "%i%Number2|BindingMode=TwoWay%/i%",
